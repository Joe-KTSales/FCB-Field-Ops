# Browser (safe to expose — protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server only (Vercel → Settings → Environment Variables). Never prefix with VITE_.
ANTHROPIC_API_KEY=sk-ant-...
